<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- WPF UI is hosted inside a WinForms DockableControl via ElementHost,
         so both desktop stacks are required. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Core</AssemblyName>
    <RootNamespace>Core</RootNamespace>
    <!-- AssemblyInfo.cs is checked in under Properties\ -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BuildInParallel>false</BuildInParallel>
    <RestoreBuildInParallel>false</RestoreBuildInParallel>
  </PropertyGroup>

  <!-- Preserve the deployed logical resource name while organizing the source
       beneath Presentation/Review. ShotReviewView loads this exact name. -->
  <ItemGroup>
    <EmbeddedResource Include="Presentation\Review\ShotReviewWindow.xaml" LogicalName="Core.Scripts.ShotReviewWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Host\**\*.cs" />
    <Compile Include="Presentation\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExtensionBootstrap\AutoEditing.ExtensionBootstrap.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Domain\AutoEditing.Domain.csproj" />
    <ProjectReference Include="..\AutomaticEditor\AutoEditing.AutomaticEditor.csproj" />
    <ProjectReference Include="..\Vegas\AutoEditing.Vegas.csproj" />
  </ItemGroup>

  <!-- VEGAS host assembly is provided by VEGAS at runtime; do not copy it locally. -->
  <ItemGroup>
    <Reference Include="ScriptPortal.Vegas">
      <HintPath>$(ProgramFiles)\VEGAS\VEGAS Pro 20.0\ScriptPortal.Vegas.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="appsettings.local.json.example" />
    <Content Include="appsettings.local.json" Condition="Exists('appsettings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Post-build: deploy to the VEGAS "Application Extensions" folder so VEGAS
       loads it at startup. A failed copy must fail Deploy; otherwise Visual
       Studio can misleadingly report success while VEGAS still loads old DLLs. -->
  <Target Name="DeployToVegasExtensions"
          AfterTargets="Build"
          Condition="'$(DeployToVegas)' != 'false' And ('$(Configuration)' == 'Deploy' Or '$(DeployToVegas)' == 'true')">
    <Message Text="Deploying AutoEditing extension to VEGAS Application Extensions..." Importance="high" />
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\.vscode\deploy-extension.ps1&quot; -Configuration $(Configuration) -ProjectDir &quot;$(MSBuildProjectDirectory)\..&quot;"
          StandardOutputImportance="high"
          StandardErrorImportance="high" />
  </Target>

</Project>
