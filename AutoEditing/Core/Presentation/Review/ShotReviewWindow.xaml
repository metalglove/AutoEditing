<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="760" MinHeight="620"
 Background="#2B2B2E" FontFamily="Segoe UI" FontSize="13">
 <UserControl.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></UserControl.InputBindings>
 <UserControl.Resources>
  <!-- VEGAS Pro 20 dark theme palette -->
  <SolidColorBrush x:Key="AppBackground" Color="#2B2B2E"/><SolidColorBrush x:Key="SidebarBackground" Color="#202022"/>
  <SolidColorBrush x:Key="CardBackground" Color="#323236"/><SolidColorBrush x:Key="CardBorder" Color="#3D3D42"/>
  <SolidColorBrush x:Key="InputBackground" Color="#1B1B1D"/><SolidColorBrush x:Key="InputBorder" Color="#46464C"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/><SolidColorBrush x:Key="TextSecondary" Color="#9A9AA2"/>
  <SolidColorBrush x:Key="TextLabel" Color="#B4B4BC"/><SolidColorBrush x:Key="Accent" Color="#4F7CF6"/>
  <SolidColorBrush x:Key="AccentMuted" Color="#8EA2FF"/><SolidColorBrush x:Key="QuietFill" Color="#3A3A40"/>
  <SolidColorBrush x:Key="QuietBorder" Color="#4A4A51"/><SolidColorBrush x:Key="DangerFill" Color="#40232A"/>
  <SolidColorBrush x:Key="DangerText" Color="#F08A96"/><SolidColorBrush x:Key="DangerBorder" Color="#5A2E37"/>
  <SolidColorBrush x:Key="LogBackground" Color="#171719"/><SolidColorBrush x:Key="LogText" Color="#8FE3B0"/>
  <SolidColorBrush x:Key="DotOk" Color="#34D399"/><SolidColorBrush x:Key="DotBad" Color="#F0556A"/>
  <SolidColorBrush x:Key="StepFill" Color="#39414F"/><SolidColorBrush x:Key="SidebarText" Color="#ECECEC"/>
  <SolidColorBrush x:Key="SidebarMuted" Color="#8A8A93"/>
  <Style TargetType="Button">
   <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="13,0"/><Setter Property="Margin" Value="0,0,9,0"/>
   <Setter Property="Background" Value="{StaticResource QuietFill}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
   <Setter Property="BorderBrush" Value="{StaticResource QuietBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource DangerFill}"/><Setter Property="Foreground" Value="{StaticResource DangerText}"/><Setter Property="BorderBrush" Value="{StaticResource DangerBorder}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="9,6"/><Setter Property="Background" Value="{StaticResource InputBackground}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="8,4"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource StepFill}"/></Trigger>
       <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="{StaticResource InputBackground}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
   <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,0,22,0"/><Setter Property="MinHeight" Value="28"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="4">
           <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
       <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Margin="{TemplateBinding Padding}" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}" Focusable="True"/>
       <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
        <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240">
         <ScrollViewer SnapsToDevicePixels="True"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEditable" Value="True">
        <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
        <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBackground}"/><Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="18"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextLabel}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource InputBackground}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/><Setter Property="RowBackground" Value="#29292D"/><Setter Property="AlternatingRowBackground" Value="#303035"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardBorder}"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{StaticResource QuietFill}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,7"/><Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="DataGridColumnHeader">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Padding" Value="6,3"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource StepFill}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderThickness" Value="0"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="VegasScrollThumb" TargetType="Thumb">
   <Setter Property="Background" Value="#5A5A61"/><Setter Property="Margin" Value="2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4"/></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#74747D"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="InvisibleScrollButton" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/><Setter Property="Opacity" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Background" Value="#202023"/><Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource VegasScrollThumb}" MinHeight="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="12"/><Setter Property="MinHeight" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5"><Track x:Name="PART_Track" Orientation="Horizontal"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource VegasScrollThumb}" MinWidth="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource InvisibleScrollButton}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource SidebarBackground}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsAiMontageMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,4,0,24"><TextBlock Text="AUTOEDITING" Foreground="{StaticResource AccentMuted}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Shot Review" Foreground="{StaticResource SidebarText}" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
   <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><Button Margin="0,0,0,8" Padding="8" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.NavigateStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Step}"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource SidebarText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{StaticResource StepFill}"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource QuietFill}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers></Style></Button.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" Foreground="{StaticResource AccentMuted}" FontWeight="Bold"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{StaticResource SidebarText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SidebarMuted}" FontSize="11"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Grid.Row="2" Content="?  How it works" Command="{Binding ShowOnboardingCommand}" Margin="0,0,0,8"/>
   <Button Grid.Row="3" Content="AI Montage" Command="{Binding ToggleAiMontageModeCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24,20"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsAiMontageMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Shot Review wizard" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="Confirm reusable sync points, then build from the clip drawer." Foreground="{StaticResource TextSecondary}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Back" Command="{Binding PreviousStepCommand}"/><Button Content="Next" Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel></Grid>
   <Grid Grid.Row="1" Margin="0,0,0,12">
    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSourcesStep}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="1 · Choose sources" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/><TextBlock Text="CLIPS FOLDER" Style="{StaticResource FieldLabel}"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ClipsFolder, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseClipsCommand}" Margin="10,0,0,0"/></Grid><TextBlock Text="SONG" Style="{StaticResource FieldLabel}"/><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SongPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseSongCommand}" Margin="10,0,0,0"/></Grid><TextBlock Text="SFX TEMPLATE FOLDER" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SfxRoot, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseSfxCommand}" Margin="10,0,0,0"/></Grid></StackPanel></Border>
    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSongAnalysisStep}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="2 · Song map" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="{Binding SongAnalysisSummary}" Foreground="{StaticResource TextSecondary}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ComboBox ItemsSource="{Binding SongEventViewModes}" SelectedValuePath="Value" SelectedValue="{Binding SongEventViewMode}" Width="185" Margin="0,0,10,0"/><Button Content="Re-analyze" Command="{Binding AnalyzeSongCommand}" Margin="0"/></StackPanel></Grid><Grid Grid.Row="1" Margin="0,12,0,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="DETECTED REGIONS" Style="{StaticResource FieldLabel}"/><ListBox Grid.Row="1" ItemsSource="{Binding SongRegions}" SelectedItem="{Binding SelectedSongRegion}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="145" Height="72" Margin="0,0,6,0" Padding="8" CornerRadius="5"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#34343A"/><Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding Type}" Value="Intro"><Setter Property="Background" Value="#334A66"/></DataTrigger><DataTrigger Binding="{Binding Type}" Value="BuildUp"><Setter Property="Background" Value="#665126"/></DataTrigger><DataTrigger Binding="{Binding Type}" Value="Action"><Setter Property="Background" Value="#643737"/></DataTrigger><DataTrigger Binding="{Binding Type}" Value="Climax"><Setter Property="Background" Value="#65385F"/></DataTrigger><DataTrigger Binding="{Binding Type}" Value="Breakdown"><Setter Property="Background" Value="#315956"/></DataTrigger><DataTrigger Binding="{Binding Type}" Value="Cinematic"><Setter Property="Background" Value="#463A67"/></DataTrigger><DataTrigger Binding="{Binding Type}" Value="Outro"><Setter Property="Background" Value="#41454D"/></DataTrigger><DataTrigger Binding="{Binding Type}" Value="Unused"><Setter Property="Opacity" Value="0.45"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"/></Grid><StackPanel Grid.Row="1" Orientation="Horizontal"><TextBlock Text="{Binding Range}" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="{Binding Energy}" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid><Grid Grid.Row="2" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding SongEventScopeTitle}" Style="{StaticResource FieldLabel}"/><DataGrid Grid.Row="1" ItemsSource="{Binding SongEvents}" SelectedItem="{Binding SelectedSongEvent}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTemplateColumn Header="Use"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Time" Binding="{Binding Time}" IsReadOnly="True"/><DataGridTextColumn Header="Musical type" Binding="{Binding Type}" IsReadOnly="True"/><DataGridTextColumn Header="Strength" Binding="{Binding Strength}" IsReadOnly="True"/><DataGridTextColumn Header="Anchor" Binding="{Binding AnchorUse}" IsReadOnly="True"/><DataGridTextColumn Header="Visual" Binding="{Binding VisualUse}" IsReadOnly="True"/><DataGridTextColumn Header="Timing" Binding="{Binding TimingUse}" IsReadOnly="True"/><DataGridCheckBoxColumn Header="Lock" Binding="{Binding IsLocked}" IsReadOnly="True"/></DataGrid.Columns></DataGrid></Grid><Border Grid.Column="2" IsEnabled="{Binding HasSelectedSongEvent}" Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="10"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding SelectedSongEvent}"><TextBlock Text="EDITORIAL TREATMENT" Style="{StaticResource FieldLabel}"/><TextBlock Text="Select a sync point to edit its treatment." Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/><TextBlock Text="{Binding Time}" FontSize="18" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/><TextBlock Text="Structural anchor" Foreground="{StaticResource TextSecondary}"/><ComboBox ItemsSource="{Binding AnchorUseOptions}" SelectedValuePath="Value" SelectedValue="{Binding AnchorUse, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Visual accent" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/><ComboBox ItemsSource="{Binding VisualUseOptions}" SelectedValuePath="Value" SelectedValue="{Binding VisualUse, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Timing treatment" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/><ComboBox ItemsSource="{Binding TimingUseOptions}" SelectedValuePath="Value" SelectedValue="{Binding TimingUse, UpdateSourceTrigger=PropertyChanged}"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Priority" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Offset (seconds)" Foreground="{StaticResource TextSecondary}"/><TextBox Text="{Binding TimingOffsetSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid><TextBlock Text="Intensity (0–1)" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/><TextBox Text="{Binding Intensity, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Lock assignment through re-analysis" IsChecked="{Binding IsLocked, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"/><TextBlock Text="Notes" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border></Grid><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="An event may remain unassigned. Anchor, visual, and timing choices are independent; lock decisions that must survive re-analysis." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Jump to selected" Command="{Binding JumpSongEventCommand}"/><Button Content="Delete selected" Command="{Binding DeleteSongEventCommand}" Style="{StaticResource DangerButton}"/><Button Content="Commit song map" Command="{Binding CommitSongReviewCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel></Grid></Grid></Border>
