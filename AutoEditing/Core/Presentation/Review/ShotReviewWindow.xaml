                <ComboBox ItemsSource="{Binding IncompleteAiSessions}" SelectedItem="{Binding SelectedIncompleteAiSession}" DisplayMemberPath="DisplayName"/>
                <TextBlock Text="{Binding SelectedIncompleteAiSession.StateSummary}" Foreground="{StaticResource AccentMuted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AiRecoveryConsequence}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap"/>
                <WrapPanel><Button Content="Resume" Command="{Binding ResumeAiSessionCommand}" Padding="7,3" Margin="0,0,4,4"/><Button Content="Pause" Command="{Binding PauseAiSessionCommand}" Padding="7,3" Margin="0,0,4,4"/><Button Content="Abandon" Command="{Binding AbandonAiSessionCommand}" Style="{StaticResource DangerButton}" Padding="7,3" Margin="0,0,0,4"/></WrapPanel>
                <TextBlock Text="{Binding AiRecoveryStatus}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Expander>
          <Expander Header="Synchronization conflict" IsExpanded="True" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8">
            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAiReconciliationConflict}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
            <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock Text="{Binding AiReconciliationSummary}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="LIVE EVENTS ELIGIBLE FOR EXPLICIT ADOPTION" Foreground="{StaticResource AccentMuted}" FontSize="10"/>
                <ComboBox ItemsSource="{Binding AiReconciliationCandidates}" SelectedItem="{Binding SelectedAiReconciliationCandidate}" DisplayMemberPath="MediaName" Margin="0,4,0,4"/>
                <TextBlock Text="{Binding SelectedAiReconciliationCandidate.Timing}" Foreground="{StaticResource AccentMuted}" FontSize="10"/>
                <TextBlock Text="{Binding SelectedAiReconciliationCandidate.AdoptionMode}" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding SelectedAiReconciliationCandidate.Constraint}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,7"/>
                <Button Content="Adopt selected known event" Command="{Binding AdoptAiReconciliationEventCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,5"/>
                <Button Content="Restore exact AI proposal" Command="{Binding RestoreAiReconciliationProposalCommand}" Margin="0,0,0,5"/>
                <Button Content="Exclude unavailable current clip" Command="{Binding ExcludeAiReconciliationClipCommand}" Margin="0,0,0,5"/>
                <Button Content="Defer and pause" Command="{Binding DeferAiReconciliationCommand}" Margin="0,0,0,5"/>
                <TextBlock Text="Adoption is available only for one exact event whose media belongs to the reviewed remaining clips and whose timing can be represented safely. Foreign, duplicate-identical, variable-velocity, and out-of-bounds events remain blocked." Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Expander>
          <Expander Header="Full rough-cut review" IsExpanded="True" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8">
            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAiRoughCutReview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
            <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
              <ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="{Binding AiRoughCutSummary}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <TextBlock Text="FULL RENDER CHUNKS" Foreground="{StaticResource AccentMuted}" FontSize="10"/>
                  <ComboBox ItemsSource="{Binding AiRoughCutChunks}" SelectedItem="{Binding SelectedAiRoughCutChunk}" DisplayMemberPath="TimeRange" Margin="0,4,0,5"/>
                  <Border Height="145" Background="#111214" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,9">
                    <MediaElement Source="{Binding AiRoughCutChunkUri}" LoadedBehavior="Play" UnloadedBehavior="Stop" Stretch="Uniform" ScrubbingEnabled="True"/>
                  </Border>
                  <TextBlock Text="AUDIT FINDINGS" Foreground="{StaticResource AccentMuted}" FontSize="10"/>
                  <ComboBox ItemsSource="{Binding AiRoughCutFindings}" SelectedItem="{Binding SelectedAiRoughCutFinding}" DisplayMemberPath="Title" Margin="0,4,0,4"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutFinding.Severity}" Foreground="{StaticResource AccentMuted}" FontSize="11"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutFinding.TimeRange}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutFinding.Checkpoints}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutFinding.Detail}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutFinding.EvidenceTrace}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutFinding.CorrectionTrace}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="10" Margin="0,2,0,4"/>
                  <Button Content="Jump to finding in VEGAS" Command="{Binding JumpAiRoughCutFindingCommand}" Margin="0,0,0,9"/>
                  <TextBlock Text="SNAPSHOT EVIDENCE" Foreground="{StaticResource AccentMuted}" FontSize="10"/>
                  <ComboBox ItemsSource="{Binding AiRoughCutEvidence}" SelectedItem="{Binding SelectedAiRoughCutEvidence}" DisplayMemberPath="TimeLabel" Margin="0,4,0,4"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutEvidence.Detail}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="10"/>
                  <Border Height="135" Background="#111214" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="4" Margin="0,4,0,4">
                    <Image Source="{Binding AiRoughCutEvidenceUri}" Stretch="Uniform"/>
                  </Border>
                  <Button Content="Jump to snapshot in VEGAS" Command="{Binding JumpAiRoughCutEvidenceCommand}" Margin="0,0,0,9"/>
                  <TextBlock Text="CORRECTION PROPOSAL" Foreground="{StaticResource AccentMuted}" FontSize="10"/>
                  <ComboBox ItemsSource="{Binding AiRoughCutCorrections}" SelectedItem="{Binding SelectedAiRoughCutCorrection}" DisplayMemberPath="Instruction" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutCorrection.Operation, StringFormat=Supported operation: {0}}" Foreground="{StaticResource AccentMuted}" FontSize="11" Margin="0,6,0,0"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutCorrection.FindingTrace}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutCorrection.Scope}" Foreground="{StaticResource AccentMuted}" FontSize="11"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutCorrection.ExpectedOutcome}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding SelectedAiRoughCutCorrection.Risk, StringFormat=Risk: {0}}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,7"/>
                  <WrapPanel><Button Content="Approve reopen" Command="{Binding ApproveAiRoughCutCorrectionCommand}" Padding="7,3" Margin="0,0,4,4"/><Button Content="Reject" Command="{Binding RejectAiRoughCutCorrectionCommand}" Padding="7,3" Margin="0,0,4,4"/><Button Content="Apply VEGAS fix" Command="{Binding ApplyAiRoughCutCorrectionCommand}" Padding="7,3" Margin="0,0,0,4"/></WrapPanel>
                  <Button Content="Accept rough cut" Command="{Binding AcceptAiRoughCutCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4,0,0"/>
                  <TextBlock Text="Every supported proposal must be applied or rejected. Advisory findings never mutate the timeline." Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Expander>
          <Expander Header="{Binding AiPolishTitle}" IsExpanded="True" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8">
            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAiPolishReview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
            <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0">
              <ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="{Binding AiPolishSummary}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                  <TextBlock Text="EXACT PLAN ACTIONS" Foreground="{StaticResource AccentMuted}" FontSize="10"/>
                  <ItemsControl ItemsSource="{Binding AiPolishActions}" Margin="0,4,0,4">
                    <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource QuietFill}" CornerRadius="4" Padding="7" Margin="0,0,0,4"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/><TextBlock Text="{Binding Target}" Foreground="{StaticResource AccentMuted}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding Timing}" Foreground="{StaticResource TextSecondary}" FontSize="10"/><TextBlock Text="{Binding Treatment}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding Rationale}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding AiPolishDiagnostics}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="COMPLETE PREVIEW" Foreground="{StaticResource AccentMuted}" FontSize="10" Margin="0,5,0,0"/>
                  <ComboBox ItemsSource="{Binding AiPolishPreviewChunks}" SelectedItem="{Binding SelectedAiPolishPreviewChunk}" DisplayMemberPath="Label" Margin="0,4,0,4"/>
                  <Border Height="135" Background="#111214" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="4">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAiPolishPreview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <MediaElement Source="{Binding AiPolishPreviewUri}" LoadedBehavior="Play" UnloadedBehavior="Stop" Stretch="Uniform" ScrubbingEnabled="True"/>
                  </Border>
                  <WrapPanel Margin="0,7,0,0"><Button Content="Approve plan" Command="{Binding ApproveAiPolishPlanCommand}" Style="{StaticResource PrimaryButton}" Padding="7,3" Margin="0,0,4,4"/><Button Content="Skip pass" Command="{Binding SkipAiPolishPlanCommand}" Padding="7,3" Margin="0,0,4,4"/><Button Content="Accept preview" Command="{Binding AcceptAiPolishPreviewCommand}" Style="{StaticResource PrimaryButton}" Padding="7,3" Margin="0,0,4,4"/><Button Content="Reject preview &amp; restore" Command="{Binding SkipAiPolishPreviewCommand}" Padding="7,3" Margin="0,0,0,4"/></WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Expander>
          <Expander Header="Final review" IsExpanded="True" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8">
            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAiFinalReview}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
            <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0"><StackPanel><TextBlock Text="{Binding AiFinalSummary}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,7"/><CheckBox Content="Render a complete final preview before promotion" IsChecked="{Binding RenderAiFinalPreview}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/><TextBlock Text="{Binding AiFinalizationConsequence}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/><Button Content="Finalize and promote montage" Command="{Binding FinalizeAiMontageCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="The complete live candidate is validated before only candidate-owned labels are promoted and the session is archived." Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
          </Expander>
          <Expander Header="Completed montage" IsExpanded="True" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8">
            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAiCompletedReport}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
            <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0"><StackPanel><TextBlock Text="{Binding AiFinalSummary}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/><TextBlock Text="{Binding AiRollbackSummary}" Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,7"/><Button Content="Roll back promotion" Command="{Binding RollbackAiPromotionCommand}" Style="{StaticResource DangerButton}"/></StackPanel></Border>
          </Expander>
        </StackPanel>
        <Expander Grid.Row="1" Header="Session usage" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12"><Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,0"><StackPanel><TextBlock Text="{Binding AiUsageModel}" Foreground="{StaticResource AccentMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/><TextBlock Text="{Binding AiSessionUsage}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding AiLifetimeUsage}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="{Binding AiUsagePerformance}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border></Expander>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Choose exactly which unaccepted work this direction may influence." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/><WrapPanel Grid.Row="1" Margin="0,0,0,6"><Button Content="More setup" Command="{Binding QuickAiSteeringCommand}" CommandParameter="Allow more setup before the first confirmed shot." Padding="7,3" Margin="0,0,4,4"/><Button Content="Tighter pacing" Command="{Binding QuickAiSteeringCommand}" CommandParameter="Use tighter pacing while preserving readable action." Padding="7,3" Margin="0,0,4,4"/><Button Content="Stronger clip" Command="{Binding QuickAiSteeringCommand}" CommandParameter="Prefer a stronger remaining clip for this musical section." Padding="7,3" Margin="0,0,4,4"/><Button Content="Another sync" Command="{Binding QuickAiSteeringCommand}" CommandParameter="Try to align another confirmed kill when the source timing permits it." Padding="7,3" Margin="0,0,4,4"/></WrapPanel><StackPanel Grid.Row="2" Margin="0,0,0,6"><ComboBox ItemsSource="{Binding AiSteeringScopes}" SelectedValuePath="Value" SelectedValue="{Binding AiSteeringScope}" ToolTip="Scope of this instruction"/><TextBlock Text="{Binding AiSteeringConsequence}" Foreground="{StaticResource AccentMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Row="3" Text="{Binding AiSteeringText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="Scoped editorial direction."/></Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="Compare with VEGAS" ToolTip="Read the current candidate timeline and show proposed-versus-actual timing without accepting it." Command="{Binding CompareAiClipCommand}" Margin="0,0,0,6"/><Button Content="Render checkpoint preview" ToolTip="Render the active clip with surrounding song context and ask the reviewer for observations. This does not alter or accept the timeline." Command="{Binding RenderAiClipPreviewCommand}" Margin="0,0,0,6"/><Button Content="{Binding AiAcceptActionLabel}" Command="{Binding AcceptAiClipCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"/><Button Content="{Binding AiFinishSyncPassLabel}" Command="{Binding FinishAiSyncPassCommand}" Margin="0,0,0,4"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DangerButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanFinishAiSyncPass}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="{Binding AiFinishSyncPassConsequence}" Foreground="{StaticResource DangerText}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,7"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanFinishAiSyncPass}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="Revise using VEGAS changes" Command="{Binding ReviseAiClipCommand}" Margin="0,0,0,6"/><Button Content="Restore AI proposal" ToolTip="Discard manual timing changes to the current candidate and restore the last AI proposal." Command="{Binding ResetAiClipCommand}" Margin="0,0,0,6"/><TextBlock Text="{Binding AiSteeringStatus}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>
   </Grid>
  </Grid>
  <Grid Grid.ColumnSpan="2" Panel.ZIndex="20"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowOnboarding}" Value="True"/><Condition Binding="{Binding IsAiMontageMode}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Grid.Style><Border Background="#DD171719"/><Border Width="590" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Padding="28"><StackPanel><TextBlock Text="From raw clips to reusable sync points" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/><TextBlock Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,14,0,18"><Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">1. Sources:</Run><Run Text=" choose clips, song, and SFX.&#x0a;&#x0a;"/><Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">2. SFX index:</Run><Run Text=" validate the sound templates.&#x0a;&#x0a;"/><Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">3. Analyze:</Run><Run Text=" detect candidate moments only for clips not already known.&#x0a;&#x0a;"/><Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">4. Review:</Run><Run Text=" reclassify outcome/gun, drag an existing marker in VEGAS to retime it then click Refresh, delete a wrong row, or move the VEGAS cursor to a missed shot and add it with + Hit/+ Headshot/+ Miss. The complete review is committed when you mark the clip ready, then the temporary timeline objects are removed.&#x0a;&#x0a;"/><Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">5. Drawer:</Run><Run Text=" browse ready clips and build a montage without keeping source clips laid out."/></TextBlock><Button Content="Got it" Command="{Binding DismissOnboardingCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0"/></StackPanel></Border></Grid>
 </Grid>
</UserControl>
