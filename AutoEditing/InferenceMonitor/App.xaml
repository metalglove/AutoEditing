<Application x:Class="AutoEditing.InferenceMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#191A1F"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#24262D"/>
        <SolidColorBrush x:Key="CardBrush" Color="#30323A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6E8CFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A9ADBA"/>
    </Application.Resources>
</Application>
