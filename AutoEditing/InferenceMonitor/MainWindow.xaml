<Window x:Class="AutoEditing.InferenceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoEditing Inference Monitor"
        Width="1500" Height="940" MinWidth="1050" MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="4,0,4,16">
            <StackPanel>
                <TextBlock Text="INFERENCE MONITOR" Foreground="{StaticResource AccentBrush}"
                           FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="Live LLM conversations" FontSize="30" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="ConnectionText" Text="Watching sessions" FontSize="14"
                           HorizontalAlignment="Right"/>
                <TextBlock x:Name="RootText" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" HorizontalAlignment="Right"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="10"
                    Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Sessions" FontSize="18"
                               FontWeight="SemiBold" Margin="4,2,4,12"/>
                    <ListBox x:Name="SessionsList" SelectionChanged="SessionsList_OnSelectionChanged"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="10"
                    Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Requests" FontSize="18"
                               FontWeight="SemiBold" Margin="4,2,4,12"/>
                    <ListBox x:Name="ExchangesList" SelectionChanged="ExchangesList_OnSelectionChanged"/>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="10"
                    Padding="20" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ConversationTitle" Text="Select a request"
                                   FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ConversationStatus" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,4,0,12"/>
                    </StackPanel>
                    <Expander Grid.Row="1" Header="Request context" Margin="0,0,0,14">
                        <StackPanel Margin="0,10,0,4">
                            <TextBlock Text="SYSTEM" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" FontSize="11"/>
                            <TextBox x:Name="SystemPromptText" MaxHeight="180" Margin="0,5,0,14"/>
                            <TextBlock Text="USER" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" FontSize="11"/>
                            <TextBox x:Name="UserPromptText" MaxHeight="280" Margin="0,5,0,4"/>
                        </StackPanel>
                    </Expander>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="ASSISTANT" Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="#1D1F25" CornerRadius="10" Padding="18">
                                <TextBox x:Name="AssistantText" FontFamily="Segoe UI"
                                         FontSize="14" MinHeight="260"/>
                            </Border>
                            <Border x:Name="GeneratingIndicator" Background="#293659"
                                    CornerRadius="8" Padding="12" Margin="0,12,0,0"
                                    Visibility="Collapsed">
                                <TextBlock Text="●  Generating — new text will appear here live"
                                           Foreground="#AFC0FF"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="3" Background="{StaticResource PanelBrush}" CornerRadius="10"
                    Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Response details" FontSize="18"
                               FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <StackPanel>
                        <TextBlock Text="Usage &amp; timings" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="11"/>
                        <TextBox x:Name="MetricsText" Margin="0,8,0,18" MinHeight="170"/>
                        <TextBlock Text="Errors" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="11"/>
                        <TextBox x:Name="ErrorText" Margin="0,8,0,18" MinHeight="120"/>
                        <TextBlock Text="Visual evidence" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="11"/>
                        <TextBox x:Name="EvidenceText" Margin="0,8,0,0" MinHeight="120"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="FooterText" Foreground="{StaticResource MutedBrush}"
                   Margin="4,12,4,0" Text="Waiting for an inference session…"/>
    </Grid>
</Window>
