<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AutoEditing.AutomationBroker.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\Host\Automation\**\*.cs"
             Link="Automation\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Vegas\Interaction\Adapters\CandidateReview\Rendering\**\*.cs"
             Link="PreviewRendering\%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\Iteration.Contracts\AutoEditing.Iteration.Contracts.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
